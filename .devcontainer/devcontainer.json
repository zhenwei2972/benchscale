{
  "name": "benchscale",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "postCreateCommand": "pip install -e '.[chat,dev]' && benchscale fetch",
  "postStartCommand": "nohup benchscale serve > /tmp/benchscale.log 2>&1 &",
  "forwardPorts": [8742],
  "portsAttributes": {
    "8742": { "label": "benchscale viewer", "onAutoForward": "openPreview" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional, only for the built-in chat. Your own Anthropic API key: it stays in your GitHub account and usage is billed to your Anthropic account. Not needed for Claude Code or the command line.",
      "documentationUrl": "https://console.anthropic.com/settings/keys"
    }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
